    "validate:content": "node scripts/validate-content.ts",
    "release-check": "node scripts/validate-content.ts --release"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
