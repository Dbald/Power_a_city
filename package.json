{
  "name": "power-a-city",
  "private": true,
  "version": "0.1.0",
  "description": "Power a City — From Source to Streetlight. A teacher-led browser lesson about how electricity reaches a neighborhood and what keeps it available.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
